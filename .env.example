# Copy this file to .env and fill in real values. Never commit .env.

# ---------- API server ----------
HOST=127.0.0.1
PORT=4207
LOG_LEVEL=INFO
# JSON list, e.g. ["http://localhost:4203"]
CORS_ORIGINS=["*"]

# ---------- Auth ----------
# Same value as QXcel's SECRET_KEY, so NG Automate can verify QXcel tokens
SECRET_KEY=

# ---------- MongoDB ----------
# Our database runs in docker compose (docker compose up -d); its root user is set below.
MONGO_URI=mongodb://ngauto:<NGAUTO_MONGO_PASSWORD>@127.0.0.1:27018/?authSource=admin
# QXcel's server (read-only for us). Leave it empty when QXcel's database is on MONGO_URI's server.
QXCEL_MONGO_URI=mongodb://localhost:27017
# Our own data: projects, runs, events
MONGO_DATABASE=ng_automate
# QXcel's database, read-only: git connections, model connections, modules
QXCEL_DATABASE=qxcel

# ---------- Project storage ----------
# Archives are saved as DATA_DIR/projects/<project_id>/source.zip
DATA_DIR=data
MAX_PROJECT_MB=200
GIT_CLONE_TIMEOUT_SECONDS=300

# ---------- Default LLM (used when a request has no model connection) ----------
# Option A: Devstral on the innovation server (Ollama)
LLM_MODEL=ollama_chat/devstral-small-2:latest
LLM_BASE_URL=http://192.168.3.90:11434
# Ollama's default context (4096) is too small for agents
LLM_NUM_CTX=32768
# Devstral has no "thinking" mode; the SDK asks for it by default
LLM_THINKING=false

# Option B: a hosted model through the gateway
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://agenticqe.ai/v1
# LLM_API_KEY=
# The gateway only allows /chat/completions
# LLM_API_MODE=chat

# ---------- Run and agent limits (change them for a faster or slower model) ----------
# The whole run: analyze, generate, tests and healing. Keep it above HEALER_TIME_BUDGET_SECONDS.
RUN_TIMEOUT_SECONDS=7200
# All healing in one run shares this time (paused time does not count). Then the healer stops: timed out.
HEALER_TIME_BUDGET_SECONDS=3600
# The same failure this many runs in a row, although the healer worked on it: no progress, stop.
HEALER_SAME_FAILURE_LIMIT=3
# Agent steps in one heal; then the tests run again and the next heal goes on.
HEALER_MAX_ITERATIONS=60
# One run of the project's tests.
TEST_RUN_TIMEOUT_SECONDS=1800
ANALYZER_MAX_ITERATIONS=40
GENERATOR_MAX_ITERATIONS=60
GENERATOR_TIMEOUT_SECONDS=1500
# One LLM call that reads a part of a free-form test-data source.
TEST_DATA_LLM_TIMEOUT_SECONDS=1200
# A run paused longer than this is stopped.
MAX_PAUSE_SECONDS=1800

# ---------- Docker dependencies (docker compose up -d) ----------
# Root user of the ngauto-mongo container; compose reads these two values from this file.
NGAUTO_MONGO_USER=ngauto
NGAUTO_MONGO_PASSWORD=

# ---------- Healer memory: Qdrant (docker compose) + an embedding model on Ollama ----------
# Earlier heals of the same organization, found by similarity and given to the healer as context.
HEAL_MEMORY_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333
# Only when Qdrant has authentication turned on (QDRANT__SERVICE__API_KEY in docker-compose.yml)
# QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=ngauto_heal_memories
# The Ollama server with the embedding model (only embeddings; the healer reasons with LLM_MODEL)
EMBEDDING_BASE_URL=http://<machine-ip>:11435
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Memories per heal, and the minimum similarity (qwen3-embedding:0.6b: same problem 0.82-0.95, others 0.36-0.71)
HEAL_MEMORY_LIMIT=3
HEAL_MEMORY_MIN_SCORE=0.75
