# Copy this file to .env and fill in real values. Never commit .env.

# LLM (any LiteLLM model name: gpt-4.1-mini, openai/<model> for gateways, azure/<deployment>, ollama/<model>)
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_API_KEY=
# chat | responses | auto. Use "chat" for gateways that only allow /chat/completions.
LLM_API_MODE=chat

# MongoDB (used later for model connections, runs and events)
MONGO_URI=mongodb://localhost:27017
