# Copy this file to .env and fill in real values. Never commit .env.

# --- Option A: local model on the innovation server (Ollama) ---
# ollama_chat/ uses Ollama's chat API, which handles tool calls best.
LLM_MODEL=ollama_chat/devstral-small-2:latest
LLM_BASE_URL=http://192.168.3.90:11434
# Ollama's default context (4096) is too small for agents.
LLM_NUM_CTX=32768
# Devstral has no "thinking" mode; the SDK turns it on by default.
LLM_THINKING=false

# --- Option B: hosted model through the gateway ---
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://agenticqe.ai/v1
# LLM_API_KEY=
# chat | responses | auto. The gateway only allows /chat/completions, so use "chat".
# LLM_API_MODE=chat

# MongoDB (used later for model connections, runs and events)
MONGO_URI=mongodb://localhost:27017
