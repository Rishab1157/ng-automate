{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Hello agent (pick a repo)",
      "type": "debugpy",
      "request": "launch",
      "module": "ng_automate",
      "args": ["hello", "${input:repoPath}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Hello agent (step into OpenHands SDK too)",
      "type": "debugpy",
      "request": "launch",
      "module": "ng_automate",
      "args": ["hello", "${input:repoPath}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "repoPath",
      "type": "promptString",
      "description": "Repo folder for the agent to look at",
      "default": "C:\\Users\\Rishab Sharma\\Desktop\\projects\\QXcel\\QXcel-API"
    }
  ]
}
