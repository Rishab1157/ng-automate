#!/usr/bin/env python3
"""ngauto-find-elements URL [--wait-ms N] [--max N]

Lists the interactive elements of a live page (links, buttons, inputs, ...) with candidate locators, so tests can
use locators that really exist. No guessing: every locator printed was run against the rendered page and matched
exactly one element. Prints JSON:

  {"url": ..., "title": ..., "elements": [
     {"tag", "type", "role", "text", "label", "visible", "candidates": [{"strategy", "value"}, ...]}, ...]}

strategy is one of css, id, name, xpath (Selenium's By.CSS_SELECTOR, By.ID, By.NAME, By.XPATH). Visible elements
come first. Drives headless Chromium through the image's chromedriver (W3C WebDriver protocol, standard library only).
"""

import argparse
import json
import os
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ALLOWED_SCHEMES = ("http", "https", "file")
PAGE_LOAD_TIMEOUT_MS = 60_000
SCRIPT_TIMEOUT_MS = 30_000
DRIVER_START_SECONDS = 10

# Runs in the page. arguments[0] is the most elements to return.
SCAN_JS = r"""
const MAX = arguments[0];
const SELECTOR = 'a[href],button,input:not([type=hidden]),select,textarea,summary,[role=button],[role=link],'
  + '[role=checkbox],[role=radio],[role=switch],[role=tab],[role=menuitem],[role=option],[role=combobox],'
  + '[role=textbox],[role=searchbox],[contenteditable=true],[onclick]';
// A CSS string literal: backslashes and double quotes escaped.
const cssString = (v) => '"' + String(v).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';
// An XPath string literal (XPath 1.0 has no escapes: pick the quote the text does not use).
const xpathString = (v) => !v.includes('"') ? '"' + v + '"' : (!v.includes("'") ? "'" + v + "'" : null);
const cssCount = (css) => { try { return document.querySelectorAll(css).length; } catch (e) { return -1; } };
const xpathCount = (xp) => {
  try {
    return document.evaluate(xp, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null).snapshotLength;
  } catch (e) { return -1; }
};
const isVisible = (el) => {
  const box = el.getBoundingClientRect();
  const style = getComputedStyle(el);
  return box.width > 0 && box.height > 0 && style.visibility !== 'hidden' && style.display !== 'none';
};
const labelOf = (el) => {
  if (el.id) {
    const label = document.querySelector('label[for=' + cssString(el.id) + ']');
    if (label) return label.innerText.trim();
  }
  const parent = el.closest('label');
  return parent ? parent.innerText.trim() : null;
};
const candidatesOf = (el, tag, text) => {
  const found = [];
  const add = (strategy, value, matches) => { if (matches === 1) found.push({strategy, value}); };
  for (const attr of ['data-test', 'data-testid', 'data-test-id', 'data-qa', 'data-cy']) {
    const value = el.getAttribute(attr);
    if (value) { const css = '[' + attr + '=' + cssString(value) + ']'; add('css', css, cssCount(css)); }
  }
  if (el.id) add('id', el.id, cssCount('#' + CSS.escape(el.id)));
  const name = el.getAttribute('name');
  if (name) add('name', name, cssCount('[name=' + cssString(name) + ']'));
  for (const attr of ['aria-label', 'placeholder']) {
    const value = el.getAttribute(attr);
    if (value) { const css = tag + '[' + attr + '=' + cssString(value) + ']'; add('css', css, cssCount(css)); }
  }
  const literal = text && text.length <= 50 ? xpathString(text) : null;
  if (literal) { const xp = '//' + tag + '[normalize-space(.)=' + literal + ']'; add('xpath', xp, xpathCount(xp)); }
  return found;
};
const all = Array.from(document.querySelectorAll(SELECTOR)).map((el) => ({el, visible: isVisible(el)}));
all.sort((a, b) => Number(b.visible) - Number(a.visible));  // stable: page order within each group
const elements = all.slice(0, MAX).map(({el, visible}) => {
  const tag = el.tagName.toLowerCase();
  const text = (el.innerText || el.value || '').trim().replace(/\s+/g, ' ').slice(0, 80);
  return {tag, type: el.getAttribute('type'), role: el.getAttribute('role'), text: text || null, label: labelOf(el),
          visible, candidates: candidatesOf(el, tag, text)};
});
return {url: location.href, title: document.title, total_found: all.length, elements};
"""


class ScanError(Exception):
    pass


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="ngauto-find-elements",
        description="List a page's interactive elements with locators checked unique (JSON on stdout).",
    )
    parser.add_argument("url", help="page to scan: http://, https:// or file://")
    parser.add_argument("--wait-ms", type=int, default=1500, help="wait after the page loaded, for scripts to render")
    parser.add_argument("--max", type=int, default=150, help="most elements to list (visible ones first)")
    args = parser.parse_args()
    if urllib.parse.urlsplit(args.url).scheme.lower() not in ALLOWED_SCHEMES:
        parser.error("the URL must start with http://, https:// or file://")
    if not 0 <= args.wait_ms <= 60_000:
        parser.error("--wait-ms must be between 0 and 60000")
    if not 1 <= args.max <= 1000:
        parser.error("--max must be between 1 and 1000")
    try:
        result = scan(args.url, args.wait_ms, args.max)
    except ScanError as error:
        print(f"ngauto-find-elements: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=1, ensure_ascii=False))
    return 0


def scan(url: str, wait_ms: int, max_elements: int) -> dict:
    port = _free_port()
    try:
        driver = subprocess.Popen(
            ["chromedriver", f"--port={port}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
    except OSError as error:
        raise ScanError(f"chromedriver could not be started: {error}") from None
    base = f"http://127.0.0.1:{port}"
    try:
        _wait_for_driver(base, driver)
        capabilities = {"capabilities": {"alwaysMatch": {
            "browserName": "chrome",
            "goog:chromeOptions": {
                "binary": os.environ.get("CHROME_BIN", "/usr/bin/chromium"),
                "args": ["--headless=new", "--no-sandbox", "--disable-dev-shm-usage", "--disable-gpu",
                         "--window-size=1366,900"],
            },
            "timeouts": {"pageLoad": PAGE_LOAD_TIMEOUT_MS, "script": SCRIPT_TIMEOUT_MS},
        }}}
        session = _call(base, "POST", "/session", capabilities)["sessionId"]
        try:
            _call(base, "POST", f"/session/{session}/url", {"url": url})
            time.sleep(wait_ms / 1000)
            return _call(base, "POST", f"/session/{session}/execute/sync", {"script": SCAN_JS, "args": [max_elements]})
        finally:
            try:
                _call(base, "DELETE", f"/session/{session}")
            except ScanError:
                pass
    finally:
        driver.terminate()
        try:
            driver.wait(timeout=5)
        except subprocess.TimeoutExpired:
            driver.kill()


def _free_port() -> int:
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def _wait_for_driver(base: str, driver: subprocess.Popen) -> None:
    deadline = time.monotonic() + DRIVER_START_SECONDS
    while time.monotonic() < deadline:
        if driver.poll() is not None:
            raise ScanError(f"chromedriver exited with code {driver.returncode}")
        try:
            if _call(base, "GET", "/status").get("ready"):
                return
        except ScanError:
            pass
        time.sleep(0.1)
    raise ScanError(f"chromedriver did not start within {DRIVER_START_SECONDS} seconds")


def _call(base: str, method: str, path: str, body: dict | None = None) -> dict:
    """One WebDriver command; returns its "value". WebDriver errors become ScanError with the driver's message."""
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(
        base + path, data=data, method=method, headers={"Content-Type": "application/json; charset=utf-8"}
    )
    timeout = (PAGE_LOAD_TIMEOUT_MS + SCRIPT_TIMEOUT_MS) / 1000 + 30
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read()).get("value") or {}
    except urllib.error.HTTPError as error:
        try:
            value = json.loads(error.read()).get("value") or {}
            message = f"{value.get('error', 'error')}: {str(value.get('message', '')).splitlines()[0]}"
        except (ValueError, AttributeError, IndexError):
            message = f"HTTP {error.code}"
        raise ScanError(message) from None
    except (urllib.error.URLError, OSError, ValueError) as error:
        raise ScanError(f"chromedriver did not answer: {error}") from None


if __name__ == "__main__":
    sys.exit(main())
